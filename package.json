{
  "name": "pioneer",
  "version": "2.6.0",
  "description": "Discord music bot using discord.js v14",
  "main": "src/index.ts",
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register  src/index.ts",
    "dev": "ts-node -r tsconfig-paths/register  src/index.ts -v --trace-deprecation",
    "migrate": "npx prisma-merge --baseFile \"prisma/base.prisma\" --schemaFilePatterns \"prisma/**/*.prisma\" --outputFile \"prisma/schema.prisma\" && npx prisma migrate dev"
  },
  "author": "Sobgo",
  "license": "MIT",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.18.0",
    "@prisma/client": "^6.12.0",
    "cheerio": "^1.1.2",
    "discord.js": "^14.21.0",
    "prisma": "^6.12.0",
    "sqlite3": "^5.1.7",
    "tweetnacl": "^1.0.3",
    "youtube-dl-exec": "^3.0.22"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/node-fetch": "^2.6.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}
