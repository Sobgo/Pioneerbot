{
  "name": "pioneer",
  "version": "2.7.0",
  "description": "Discord music bot using discord.js",
  "main": "src/index.ts",
  "scripts": {
    "start": "npx tsx -r tsconfig-paths/register  src/index.ts",
    "dev": "npx tsx -r tsconfig-paths/register  src/index.ts -v",
    "migrate": "npx prisma-merge --baseFile \"prisma/base.prisma\" --schemaFilePatterns \"prisma/**/*.prisma\" --outputFile \"prisma/schema.prisma\" && npx prisma migrate dev"
  },
  "author": "Sobgo",
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@prisma/client": "^6.19.3",
    "cheerio": "^1.2.0",
    "discord.js": "^14.27.0",
    "opusscript": "^0.0.8",
    "prisma": "^6.19.2",
    "sqlite3": "^5.1.7",
    "tweetnacl": "^1.0.3",
    "youtube-dl-exec": "^3.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/node-fetch": "^2.6.13",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}